erDiagram
  universities ||--o{ academic_sessions : defines
  universities ||--o{ faculties : has
  faculties ||--o{ departments : has
  departments ||--o{ courses : owns
  departments ||--o{ curriculum_entries : offers
  courses ||--o{ curriculum_entries : listed_in
  courses ||--o{ timetable_slots : scheduled_as
  departments ||--o{ lecturers : employs
  courses ||--o{ course_lecturers : taught_by
  lecturers ||--o{ course_lecturers : teaches

  universities ||--o{ authorities : has
  faculties ||--o{ authorities : dean_of
  departments ||--o{ authorities : hod_of
  universities ||--o{ routing_steps : configures

  universities ||--o{ student_accounts : enrols
  departments ||--o{ student_accounts : declared_in
  student_accounts ||--o{ student_verifications : has
  student_accounts ||--o{ student_sessions : maintains
  universities ||--o{ email_challenges : issues
  student_accounts ||--o{ student_course_registrations : registers
  courses ||--o{ student_course_registrations : registered_in
  student_accounts ||--o{ anomaly_signals : flagged_by

  courses ||--o{ findings : subject_of
  timetable_slots ||--o{ findings : slot_of
  findings ||--o{ reports : groups
  student_accounts ||--o{ reports : submits
  reports ||--o{ report_evidence : has
  findings ||--o{ finding_confirmations : confirmed_by
  student_accounts ||--o{ finding_confirmations : confirms
  findings ||--o{ finding_scores : scored_as

  model_registry ||--o{ eval_runs : evaluated_in
  model_registry ||--o{ panel_votes : casts
  findings ||--o{ appeals : appealed_in
  findings ||--o{ decision_log : recorded_in

  courses ||--o{ class_notices : announced_for
  lecturers ||--o{ class_notices : posts
  findings ||--o{ lecturer_replies : answered_by
  lecturers ||--o{ lecturer_replies : writes

  findings ||--o{ deliveries : delivered_as
  authorities ||--o{ deliveries : receives
  deliveries ||--o{ authority_responses : answered_with

  universities {
    uuid id PK
    text name
    text short_name
    citext email_domain
  }
  academic_sessions {
    uuid id PK
    uuid university_id FK
    text session
    calendar_status status
    date returning_registration_starts
    date fresh_registration_starts
    date first_semester_lectures_start
    date first_semester_lectures_end
    date first_semester_exams_start
    date first_semester_exams_end
    date second_semester_lectures_start
    date second_semester_lectures_end
    date second_semester_exams_start
    date second_semester_exams_end
    date session_ends
    text source
  }
  faculties {
    uuid id PK
    uuid university_id FK
    text name
  }
  departments {
    uuid id PK
    uuid faculty_id FK
    text name
  }
  courses {
    uuid id PK
    uuid department_id FK
    text code
    text title
    smallint level
  }
  curriculum_entries {
    uuid department_id PK
    uuid course_id PK
    smallint level PK
    smallint semester
    boolean is_elective
    text source
  }
  timetable_slots {
    uuid id PK
    uuid course_id FK
    text academic_session
    smallint semester
    smallint day_of_week
    time start_time
    time end_time
    text venue
    slot_type kind
  }
  lecturers {
    uuid id PK
    uuid department_id FK
    text full_name
    citext email
  }
  course_lecturers {
    uuid course_id PK
    uuid lecturer_id PK
    text academic_session PK
  }
  authorities {
    uuid id PK
    uuid university_id FK
    authority_role role
    uuid faculty_id FK
    uuid department_id FK
    text full_name
    citext email
    boolean is_active
  }
  routing_steps {
    uuid id PK
    uuid university_id FK
    report_category category
    smallint step_order
    authority_role authority_role
    smallint wait_days
  }
  student_accounts {
    uuid id PK
    uuid university_id FK
    uuid department_id FK
    smallint level
    bytea identity_hash
    account_status status
    text confirmed_session
    timestamptz created_at
  }
  student_verifications {
    uuid id PK
    uuid student_id FK
    verification_factor factor
    boolean passed
    numeric score
    timestamptz verified_at
  }
  email_challenges {
    uuid id PK
    uuid university_id FK
    bytea identity_hash
    bytea code_hash
    smallint attempts
    smallint max_attempts
    timestamptz created_at
    timestamptz expires_at
    timestamptz consumed_at
  }
  student_sessions {
    uuid id PK
    uuid student_id FK
    bytea token_hash
    timestamptz created_at
    timestamptz expires_at
    timestamptz revoked_at
  }
  student_course_registrations {
    uuid student_id PK
    uuid course_id PK
    text academic_session PK
  }
  trust_weights {
    verification_factor factor PK
    numeric weight
  }
  platform_settings {
    text key PK
    numeric value
    text note
  }
  model_registry {
    uuid id PK
    panel_role role
    text provider
    text model
    text version
    text prompt_version
    boolean is_active
    timestamptz created_at
  }
  circuit_breakers {
    text name PK
    breaker_state state
    text reason
    timestamptz tripped_at
    timestamptz reset_after
  }
  golden_cases {
    uuid id PK
    golden_label label
    jsonb payload
    vote_verdict expected
    timestamptz created_at
  }
  eval_runs {
    uuid id PK
    eval_source source
    uuid model_id FK
    numeric precision_score
    numeric recall_score
    jsonb per_label
    boolean passed
    timestamptz ran_at
  }
  findings {
    uuid id PK
    uuid course_id FK
    report_category category
    date incident_date
    uuid slot_id FK
    finding_status status
    text public_summary
    smallint clearance_tier
    timestamptz held_until
    timestamptz cleared_at
    timestamptz created_at
  }
  reports {
    uuid id PK
    text tracking_code
    uuid reporter_id FK
    uuid finding_id FK
    text description
    boolean notice_given
    timestamptz created_at
  }
  finding_confirmations {
    uuid id PK
    uuid finding_id FK
    uuid student_id FK
    text comment
    timestamptz created_at
  }
  report_evidence {
    uuid id PK
    uuid report_id FK
    evidence_kind kind
    text storage_key
    text sha256
    boolean metadata_stripped
    timestamptz delete_after
    timestamptz created_at
  }
  panel_votes {
    uuid id PK
    text subject_type
    uuid subject_id
    smallint round
    panel_role role
    uuid model_id FK
    vote_verdict verdict
    numeric confidence
    jsonb reasons
    timestamptz created_at
  }
  anomaly_signals {
    uuid id PK
    uuid student_id FK
    text kind
    numeric severity
    jsonb detail
    timestamptz created_at
  }
  finding_scores {
    uuid id PK
    uuid finding_id FK
    text formula_version
    numeric score
    integer supporters
    jsonb breakdown
    timestamptz computed_at
  }
  decision_log {
    bigserial id PK
    uuid finding_id FK
    text stage
    text actor
    text decision
    jsonb details
    bytea prev_hash
    bytea entry_hash
    timestamptz created_at
  }
  appeals {
    uuid id PK
    uuid finding_id FK
    appellant_kind appellant
    uuid lecturer_id FK
    uuid authority_id FK
    uuid report_id FK
    text body
    appeal_status status
    smallint round
    timestamptz created_at
    timestamptz decided_at
  }
  class_notices {
    uuid id PK
    uuid course_id FK
    uuid lecturer_id FK
    notice_kind kind
    date for_date
    timestamptz new_start
    text note
    timestamptz posted_at
  }
  lecturer_replies {
    uuid id PK
    uuid finding_id FK
    uuid lecturer_id FK
    reply_reason reason
    text body
    timestamptz created_at
  }
  deliveries {
    uuid id PK
    uuid finding_id FK
    uuid authority_id FK
    smallint step_order
    delivery_status status
    bytea token_hash
    timestamptz queued_at
    timestamptz sent_at
    timestamptz viewed_at
    timestamptz acknowledged_at
    timestamptz responded_at
    timestamptz due_at
  }
  authority_responses {
    uuid id PK
    uuid delivery_id FK
    response_outcome outcome
    text body
    timestamptz created_at
  }
