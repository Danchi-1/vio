# Copy to .env.local (already git-ignored at the repo root) and fill in real
# values. Never commit actual secrets.

# Neon Postgres connection string (pooled, for API traffic).
DATABASE_URL=

# HMAC secret for student_accounts.identity_hash and email_challenges.code_hash.
# Generate once, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotating this invalidates every existing identity hash and challenge.
IDENTITY_HASH_SECRET=

# HMAC secret for student_sessions.token_hash. Must be different from
# IDENTITY_HASH_SECRET so the two cannot be used interchangeably.
SESSION_SECRET=

# Gmail SMTP with an app password (docs/DECISIONS.md, 2026-11-10): a
# development-stage choice only. Replace with a dedicated transactional
# provider before any real student-facing launch.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM_ADDRESS=

# Optional overrides; defaults match docs/DECISIONS.md. The expiry/cooldown
# values are approved; the attempt/hourly caps are provisional defaults
# pending explicit confirmation (see "Pending Before M2 Can Close").
EMAIL_CHALLENGE_TTL_MINUTES=10
EMAIL_CHALLENGE_RESEND_COOLDOWN_SECONDS=60
EMAIL_CHALLENGE_MAX_ATTEMPTS=5
EMAIL_CHALLENGE_MAX_PER_HOUR=5
STUDENT_SESSION_TTL_DAYS=30

# Exact browser origins allowed to call the API with the student session cookie.
# Keep this allowlist explicit; do not use "*" with credentialed requests.
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Cookie security flags. Keep COOKIE_SECURE=true and COOKIE_SAMESITE=strict on
# same-site HTTPS. If testing over plain http://<nobus-ip>, set COOKIE_SECURE=false
# and COOKIE_SAMESITE=lax. For cross-site HTTPS frontend, use COOKIE_SAMESITE=none.
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# Email delivery mode: "smtp" (default, fail-closed) or "console" (dev/hackathon
# fallback that prints OTP codes to stdout when SMTP credentials are not set).
EMAIL_MODE=smtp

# Groq API key for intake (safety + extractor) and Stage 4 panel gate.
GROQ_API_KEY=

# Stage 6 secrets (authority/lecturer link sessions + escalation worker).
AUTHORITY_SESSION_SECRET=
LECTURER_SESSION_SECRET=
WORKER_SECRET=
