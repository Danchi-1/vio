[Unit]
Description=VIO (Voice It Out) FastAPI Backend
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/vio/backend
EnvironmentFile=/opt/vio/backend/.env
ExecStart=/opt/vio/.venv/bin/uvicorn vio_backend.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
