# Copy to .env.local for local work. On the host (Vercel/Netlify) set these as environment variables.
# They are read at BUILD time, so redeploy after changing them.

# The one place the API base URL lives.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# mock = sample data with a visible banner on every page (the safe default).
# live = real backend. Set live only for a deployment that should talk to the API.
VITE_API_MODE=mock

# The spec says a student_session cookie is set. Turn this on only once cookie auth works
# across the frontend and API domains (cross-site cookies can fail).
VITE_API_CREDENTIALS=false
