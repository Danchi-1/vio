# Copy to .env.local. Never commit real values.
# One place for the API base URL.
VITE_API_BASE_URL=http://localhost:8000/api/v1
# live or mock. Mock mode shows a banner on every page.
VITE_API_MODE=mock
# Spec says a student_session cookie is set. Set true only once cookie auth is confirmed end to end.
VITE_API_CREDENTIALS=false
